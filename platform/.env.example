# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta). All of these come from the Meta app dashboard:
# App > WhatsApp > API setup.
# ---------------------------------------------------------------------------

# Numeric id of the sending phone number ("Phone number ID", NOT the number).
META_PHONE_NUMBER_ID=

# Access token. The console token lasts 24h; a System User token is permanent.
META_WHATSAPP_TOKEN=

# Graph API version this deployment is pinned to. Meta keeps each version
# alive for at least two years, so pinning is safer than tracking "latest".
META_GRAPH_VERSION=v27.0

# What the channel actually is, declared explicitly instead of guessed.
# "test_number"  = Meta's shared test number: only pre-loaded recipients.
# "own_number"   = a registered business number in a live app.
META_CHANNEL_MODE=test_number

# Recipients Meta has on the allowlist for a test number, comma separated,
# digits only with country code. Used to fail loudly BEFORE calling Meta.
META_ALLOWED_RECIPIENTS=

# ---------------------------------------------------------------------------
# Safety rail. Sending is OFF unless this is exactly "true".
# With it unset the MCP server still drafts and still validates; it refuses
# to deliver, and says so in a structured way the agent can report.
# ---------------------------------------------------------------------------
WHATSAPP_ALLOW_SEND=false

# ---------------------------------------------------------------------------
# Auth for the MCP endpoints. Anyone holding this key can ask this server to
# draft and (if sending is enabled) deliver messages. Accepted as
# "Authorization: Bearer <key>" or as "?key=<key>" in the URL; the setup script
# uses the URL form, the only one Paperclip lets a script configure.
# ---------------------------------------------------------------------------
MCP_API_KEY=

# ---------------------------------------------------------------------------
# Date the inventory is evaluated against. Pinned to the seed's date so the
# demo is reproducible; "today" uses the clock.
# ---------------------------------------------------------------------------
INVENTORY_AS_OF=2026-11-08

# ---------------------------------------------------------------------------
# Status webhook (/api/whatsapp/webhook). Configured in the Meta app under
# WhatsApp > Configuration, subscribed to the "messages" field.
# META_APP_SECRET is under App settings > Basic and verifies each notice.
# The verify token is any string you choose; Meta echoes it on subscribe.
# ---------------------------------------------------------------------------
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Where delivery statuses are kept (Upstash Redis, created from Vercel >
# Storage). Without it the webhook still validates and logs every notice.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# "true" when the WhatsApp Business account is shared with another app. Only
# statuses of messages this server sent are stored either way; with a shared
# account, inbound replies are dropped too, since they may belong to the other
# app.
WHATSAPP_SHARED_ACCOUNT=false

# Which approved template the offer uses: oferta_lote_por_vencer (the full
# offer, default) or oferta_lote_simple (a short invitation without prices).
WHATSAPP_OFFER_TEMPLATE=oferta_lote_por_vencer

# ---------------------------------------------------------------------------
# Paperclip control plane, read by the dashboard only.
# ---------------------------------------------------------------------------
PAPERCLIP_API_URL=http://127.0.0.1:3100/api
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=

# ---------------------------------------------------------------------------
# Redes (LinkedIn). Sin estas variables, los posteos se
# arman y se validan, y publicar devuelve un dry-run explícito. Publicar como
# página exige que LinkedIn apruebe la app para la Community Management API.
# ---------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
# Quién publica: urn:li:person:... (tu perfil, sólo exige Share on LinkedIn) o
# urn:li:organization:... (la página, exige la Community Management API).
# scripts/linkedin-connect.mjs te da las dos variables. Ver docs/LINKEDIN.md.
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202610
SOCIAL_ALLOW_PUBLISH=false
